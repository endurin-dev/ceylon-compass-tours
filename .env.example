# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/ceylon_compass_tours?schema=public"

# Auth.js - replace this placeholder with a random secret before starting the app.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Cloudinary (optional until media uploads are implemented)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email provider (optional until email is implemented)
EMAIL_FROM="bookings@example.com"
EMAIL_SERVER=""

# Payment gateway (do not enable live payments until server-side webhook verification is implemented)
PAYMENT_API_KEY=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
